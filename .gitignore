android-app/.kotlin/
android-app/app/build/
android-app/*.iml
android-app/**/*.iml
.externalNativeBuild/
.cxx/
local.properties

# Release Binaries (distributed via GitHub Releases, not committed to git tree)
release/*.apk
*.apk

